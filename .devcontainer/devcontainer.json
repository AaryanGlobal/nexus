{
  "name": "Hermes-Pi Bridge",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:18": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "charliermarsh.ruff"
      ]
    }
  },
  "postCreateCommand": "pip install -e packages/core -e packages/hermes-plugin && cd packages/pi-extension && npm install",
  "ports": [
    {
      "hostPort": 2719,
      "containerPort": 2719,
      "description": "pi Bridge Server"
    },
    {
      "hostPort": 8080,
      "containerPort": 8080,
      "description": "Hermes Bridge Server"
    }
  ]
}